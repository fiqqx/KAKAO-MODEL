digraph Preprocessing {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.3, ranksep=0.34, margin=0, pad=0.15, label="Flowchart Preprocessing Data", labelloc=t, fontsize=19];
  node [fontname="DejaVu Sans", fontsize=14, color="#222222", penwidth=1.1, style=filled, fillcolor="white", margin="0.16,0.10", width=3.6];
  edge [color="#222222", penwidth=1.1, arrowsize=0.75];
  start [label="Mulai", shape=ellipse, width=1.9];
  photos [label="Ambil foto biji kakao", shape=box];
  labels [label="Label bounding box dan\n3 kelas di Roboflow", shape=box];
  split [label="Bagi train / validation / test\nberdasarkan kelompok foto asal", shape=box];
  coco [label="Ekspor COCO JSON\ndan periksa anotasi", shape=box];
  rgb [label="Konversi RGB ke tensor", shape=box];
  flip [label="Horizontal flip 50%\nhanya pada train", shape=box];
  modelprep [label="Resize 320 × 320 dan normalisasi\notomatis di dalam model", shape=box];
  end [label="Data siap diproses model", shape=ellipse, width=3.6];
  start -> photos -> labels -> split -> coco -> rgb -> flip -> modelprep -> end;
}
