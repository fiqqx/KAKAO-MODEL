@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #394B40
skinparam activity {
  BackgroundColor #F7FAF6
  BorderColor #394B40
  FontColor #25352C
  DiamondBackgroundColor #FFF6E9
  DiamondBorderColor #806244
  StartColor #394B40
  EndColor #394B40
}
title Activity - Melihat dan Mengelola Riwayat
start
:Buka halaman Riwayat\ndari navigasi website;
:Ambil riwayat milik sesi browser ini;
if (Riwayat tersedia?) then (Ya)
  :Tampilkan daftar kartu riwayat;
  if (Pilih satu item?) then (Ya)
    :Periksa kepemilikan di server;\nambil detail riwayat;
    :Tampilkan gambar, waktu, mode,\ntotal dan jumlah per kelas;
    switch (Tindakan berikutnya?)
    case (Unduh)
      :Periksa kepemilikan;\nunduh gambar hasil;
    case (Hapus)
      :Minta konfirmasi penghapusan;
      if (Dikonfirmasi?) then (Ya)
        :Periksa kepemilikan; hapus satu\nriwayat dan berkas terkait;
        :Perbarui daftar riwayat;
      else (Tidak)
        :Tetap pada detail;
      endif
    case (Kembali)
      :Kembali ke daftar riwayat;
    endswitch
  else (Tidak)
  endif
else (Tidak)
  :Tampilkan Riwayat masih kosong;\nberi tautan mulai deteksi;
endif
:Kembali ke beranda atau lanjut\nmenggunakan website;
stop
@enduml
