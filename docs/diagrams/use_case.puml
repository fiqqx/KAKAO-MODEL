@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam ArrowColor #222222
skinparam actorBorderColor #222222
skinparam actorFontColor #222222
skinparam usecase {
  BackgroundColor white
  BorderColor #222222
  FontColor #222222
}
skinparam rectangle {
  BackgroundColor white
  BorderColor #222222
  FontColor #222222
}
title Use Case Website Deteksi Biji Kakao
actor "Pengguna" as U
rectangle "Website Deteksi Biji Kakao" {
  usecase "Deteksi kamera" as CAM
  usecase "Deteksi gambar unggahan" as UPLOAD
  usecase "Lihat hasil dan jumlah biji" as RESULT
  usecase "Simpan riwayat" as SAVE
  usecase "Lihat riwayat" as HISTORY
  usecase "Unduh gambar hasil" as DOWNLOAD
  usecase "Hapus riwayat" as DELETE
}
U -- CAM
U -- UPLOAD
U -- SAVE
U -- HISTORY
U -- DOWNLOAD
U -- DELETE
CAM ..> RESULT : <<include>>
UPLOAD ..> RESULT : <<include>>
UPLOAD ..> SAVE : <<include>>
SAVE ..> CAM : <<extend>>\n[tekan Simpan Hasil]
CAM -[hidden]down-> UPLOAD
HISTORY -[hidden]down-> DOWNLOAD
DOWNLOAD -[hidden]down-> DELETE
@enduml
